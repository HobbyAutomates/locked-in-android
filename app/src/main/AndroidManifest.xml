<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One-tap in-app updater: download a newer build and hand it to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Built-in dictation on the Meal form (SpeechRecognizer, en-IN / hi-IN). Asked for on first tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Meal reminders: exact daily alarms + a notification, re-armed after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Label scanner uses the system camera app via ACTION_IMAGE_CAPTURE; no CAMERA permission needed. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- v2.13 nutrition: live CameraX preview in the scan frame; denied = the camera-app flow above. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- v2.13 platform: share cards offer "Instagram Stories" when Instagram is installed. -->
        <package android:name="com.instagram.android" />
        <intent><action android:name="com.instagram.share.ADD_TO_STORY" /></intent>
    </queries>
    <!-- Health Connect: steps + active calories in, band sessions out. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BandLog">

        <!-- Ask Play Services to fetch the text-recognition and barcode models when the app first installs. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr,barcode" />

        <!-- Shares the downloaded update APK with the system installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BandLog"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- v2.6 squad invite links: https://web-production-ff1cf.up.railway.app/join/<code> -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="web-production-ff1cf.up.railway.app" android:pathPrefix="/join/" />
                <!-- v2.14 buddy invites: …/buddy/<code> -->
                <data android:scheme="https" android:host="web-production-ff1cf.up.railway.app" android:pathPrefix="/buddy/" />
            </intent-filter>
        </activity>
        <!-- v2.6 water reminders (fire inside the window until the goal is hit) + the "+1 glass" action. -->
        <receiver
            android:name=".alarm.WaterReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sohum.bandlog.ACTION_WATER_REMINDER" />
                <action android:name="com.sohum.bandlog.ACTION_WATER_ADD_GLASS" />
            </intent-filter>
        </receiver>
        <!-- Fires one meal nudge and re-arms tomorrow's. -->
        <receiver
            android:name=".alarm.MealReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sohum.bandlog.ACTION_MEAL_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- v2.13 nutrition: the fasting timer's one-shot "goal reached" alarm. -->
        <receiver
            android:name=".alarm.FastingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sohum.bandlog.ACTION_FASTING_GOAL" />
            </intent-filter>
        </receiver>

        <!-- Re-arms every enabled reminder after a reboot, an app update or a clock change. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- v2.13 platform: the afternoon protein nudge (re-armed by BootReceiver) and the live-workout rest timer's end. -->
        <receiver
            android:name=".alarm.ProteinNudgeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sohum.bandlog.ACTION_PROTEIN_NUDGE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".alarm.RestTimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sohum.bandlog.ACTION_REST_DONE" />
            </intent-filter>
        </receiver>

        <!-- v2.3 home-screen widget: calories left + Log food. -->
        <receiver
            android:name=".widget.CaloriesWidget"
            android:exported="false"
            android:label="Locked In · Calories">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calories_info" />
        </receiver>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
